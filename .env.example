# JWT (обязательно! сгенерируй через: openssl rand -base64 32)
# Для каждого секрета: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
# Опционально: 64 hex-символа (32 байта) для шифрования секретов TOTP админки в БД. Если не задан — ключ выводится из JWT_SECRET.
# TOTP_ENCRYPTION_KEY=

# Платёжный API (документация будет позже)
PAYMENT_API_KEY=
# Для production webhook обязателен: подпись HMAC-SHA256 тела запроса проверяется (заголовок X-Webhook-Signature: sha256=<hex>).
PAYMENT_WEBHOOK_SECRET=

# Paygine P2PMarket API. Если заданы PAYGINE_SECTOR и PAYGINE_PASSWORD — используется Paygine (SDPayIn + SDPayInSBP).
# Тест: реквизиты в ЛК https://test.paygine.com/office/ ; PAYGINE_BASE_URL не задавать.
# Прод: PAYGINE_BASE_URL=https://pay.paygine.com/webapi
# Базовый URL для запросов (до /webapi). Можно указать только хост — /webapi подставится.
# PAYGINE_BASE_URL=
# PAYGINE_SECTOR=
# PAYGINE_PASSWORD=
# Опционально: sd_ref (в ЛК Paygine часто нет такого поля). Не задавать — зачисление на счёт sector.
# PAYGINE_SD_REF=
# Кубышка ЮЛ для комиссии при приёме (СБП/карта): при переливе после оплаты fee → PAYGINE_SD_REF_LEGAL, (amount−fee) → официант.
# PAYGINE_SD_REF_LEGAL=
# При заданных PAYGINE_SECTOR и PAYGINE_PASSWORD каждая новая заявка на вывод автоматически отправляется в Paygine (SDPayOutSBP).
# Реквизиты по умолчанию — тестовые (70115110123, 1crt88888881). Свои: PAYGINE_PAYOUT_DEFAULT_PHONE, PAYGINE_PAYOUT_DEFAULT_BANK_ID.
# PAYGINE_PAYOUT_DEFAULT_PHONE=
# PAYGINE_PAYOUT_DEFAULT_BANK_ID=

# Публичный URL для ссылок и QR. В проде обязательно (free-tips.ru).
# NEXT_PUBLIC_APP_URL=https://free-tips.ru

# CSP (proxy.ts): в production без этого Chrome блокирует new Function()/eval в некоторых чанках Next.js
# (Issues: «blocks the use of 'eval'», строка вида Function("return function*() {}")).
# Включайте только если видите сломанный клиентский JS и осознаёте риск XSS.
# ALLOW_CSP_UNSAFE_EVAL=true

# Опционально: секрет для GET /api/health/payment-relocate (заголовок X-Monitoring-Secret).
# Алёрт: ok === false или stuckRelocateClaimCount > 0. В GET /api/admin/stats — paymentRelocateStuckClaimCount.
# MONITORING_SECRET=

# Доверять заголовкам прокси для IP (rate limit, логи). В production включайте только за nginx/Cloudflare с закрытым прямым доступом к Node.
# TRUST_PROXY=true
# Если TRUST_PROXY=true: не использовать первый хоп X-Forwarded-For (подделка при прямом доступе). Только CF-Connecting-IP / True-Client-IP / X-Real-IP.
# TRUST_PROXY_STRICT=true

# GET /api/health: без секрета — ответ { "status": "ok" } без проверки БД. С секретом — полный JSON только при ?secret=... или заголовке x-health-check-secret.
# HEALTH_CHECK_SECRET=

# Временно отключить все rate limit, завязанные на IP (proxy, auth, pay, webhooks и т.д.). Только на время смены IP/отладки — сразу выключите.
# DISABLE_IP_RATE_LIMIT=true

# Лимиты API (proxy): в production без API_RATE_LIMIT_MAX — дефолт 1200 запросов / 15 мин с IP.
# API_RATE_LIMIT_MAX=1200
# POST /api/pay/[slug]: в production без переменных — 60 с IP и 30 по slug за 15 мин.
# PAY_RATE_LIMIT_IP_MAX=60
# PAY_RATE_LIMIT_SLUG_MAX=30

# Rate limit: при нескольких инстансах задай REDIS_URL для общего хранилища (иначе in-memory).
# REDIS_URL=redis://localhost:6379
# Лимит POST вебхука Paygine с одного IP (окно 1 мин). По умолчанию 600; минимум 30.
# WEBHOOK_RATE_LIMIT_MAX=600
# Параллельных переливов Paygine после оплаты (очередь). С REDIS_URL — лимит общий между инстансами. По умолчанию 4; 1–32.
# PAYGINE_RELOCATE_QUEUE_CONCURRENCY=4

# PostgreSQL — строка подключения (обязательно для миграций и приложения)
# Локально: подставь свои хост, пользователя, пароль и базу
# С хоста к БД в Docker — двоеточие перед портом: localhost:15432 (не localhost15432).
DATABASE_URL="postgresql://app:changeme@127.0.0.1:15432/tips?schema=public"

# Для docker-compose: DATABASE_URL в web подставляется из POSTGRES_* и хоста db
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tips
# Порт на хосте при docker-compose (127.0.0.1:15432→5432). Сервис web в Docker ходит на db:5432 — compose не читает эту переменную.
POSTGRES_PORT=15432

# Суперадмин (для seed; при первом входе обязательная смена пароля)
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!

