<?xml version="1.0" encoding="utf-8"?>
<!-- Синий градиент карты в стиле актуального сайта -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1553AB"
                android:centerColor="#1C69D4"
                android:endColor="#4A9FFF"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
