// Prisma schema для платформы безналичных чаевых
// Все суммы в копейках (BigInt) для точности финансовых операций

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RECIPIENT           // получатель чаевых без заведения (как раньше)
  ADMIN               // администратор (глобальный)
  SUPERADMIN          // суперадминистратор (создаётся только через миграцию/seed)
  ESTABLISHMENT_ADMIN // управляющий заведением (доступ только к своему заведению)
  EMPLOYEE            // официант/сотрудник заведения (привязан к Employee)
}

enum TransactionStatus {
  PENDING   // создан, ожидает оплаты
  SUCCESS   // успешно оплачен
  FAILED    // ошибка оплаты
  CANCELLED // отменён
}

enum PayoutStatus {
  CREATED      // заявка создана
  PROCESSING   // в обработке
  COMPLETED    // выполнен
  REJECTED     // отклонён
}

enum RegistrationRequestStatus {
  PENDING   // ожидает рассмотрения
  APPROVED  // одобрена, выдан токен
  REJECTED  // отклонена
}

enum VerificationStatus {
  NONE       // заявка не подавалась
  PENDING    // заявка на рассмотрении
  VERIFIED   // верифицирован
  REJECTED   // отклонён (клиент видит причину, может подать заново)
}

enum EstablishmentBookingStatus {
  PENDING   // создана, ждёт подтверждения
  CONFIRMED // подтверждена
  SEATED    // гости за столом
  COMPLETED // визит завершён
  NO_SHOW   // не пришли
  CANCELLED // отменена
}

enum EstablishmentServiceSessionStatus {
  OPEN
  CLOSED
}

/// Заказ официанта по столу (пречек); оплата — отдельно.
enum EstablishmentTableOrderStatus {
  OPEN
  PRESENTED
  CANCELLED
}

model User {
  id                String    @id @default(cuid())
  uniqueId          Int       @unique @default(autoincrement())
  login             String    @unique @db.VarChar(50)
  email             String?   @unique @db.VarChar(255)
  passwordHash      String    @db.VarChar(255)
  /** Хеш кодового слова для восстановления пароля (bcrypt); null — аккаунты до введения поля */
  recoveryCodewordHash String? @db.VarChar(255)
  /** Зашифрованное кодовое слово для отображения суперадмину (AES-GCM); null — нет или старый аккаунт */
  recoveryCodewordEnc  String? @db.Text
  role              UserRole  @default(RECIPIENT)
  mustChangePassword Boolean   @default(false) // обязательная смена пароля при первом входе
  isBlocked         Boolean   @default(false)
  fullName          String?   @db.VarChar(255)
  birthDate         String?   @db.VarChar(20)
  establishment     String?   @db.VarChar(255) // устаревшее: дублирование названия для обратной совместимости
  establishmentId   String?   @db.VarChar(64)  // связь с заведением (для ESTABLISHMENT_ADMIN и EMPLOYEE)
  apiKey            String?   @unique @db.VarChar(64) // устаревшее: только для старых ключей до миграции на хеш
  apiKeyPrefix      String?   @db.VarChar(20) // первые 16 символов ключа для поиска
  apiKeyHash        String?   @db.VarChar(64) // SHA-256 hex ключа (новые ключи только хеш)
  payoutDailyLimitCount Int?   // лимит заявок в сутки (null = глобальный)
  payoutDailyLimitKop   BigInt? // лимит суммы в сутки, коп (null = глобальный)
  payoutMonthlyLimitCount Int?  // лимит заявок в месяц (null = 30 × суточный)
  payoutMonthlyLimitKop   BigInt? // лимит суммы вывода в месяц, коп (null = 30 × суточный)
  /// Месячный лимит суммы поступлений (чаевые) на счёт, коп; UTC-месяц. Отдельно от лимита вывода.
  incomingMonthlyLimitKop BigInt?
  autoConfirmPayouts    Boolean @default(false) // автоподтверждение выводов
  autoConfirmPayoutThresholdKop BigInt? // порог в коп: заявки до этой суммы подтверждаются автоматически (null = любая сумма при включённом флаге)
  paygineSdRef       String?   @db.VarChar(128) // кубышка официанта (присваивается при регистрации, в Paygine создаётся при первом зачислении)
  verificationStatus VerificationStatus @default(NONE)
  verificationRejectionReason String?   @db.VarChar(1000) // причина отказа (видна клиенту)
  savingFor         String?   @db.VarChar(500) // на что копит официант — показывается на странице оплаты
  profilePhotoUrl   String?   @db.VarChar(512) // фото получателя (RECIPIENT): страница оплаты и ЛК (путь в storage)
  lastAuthIp        String?   @db.VarChar(64) // последний IP входа/регистрации (наблюдение: несколько аккаунтов с одного IP)
  /** TOTP (Google Authenticator) для любого ЛК: секрет в БД только в зашифрованном виде */
  totpEnabled    Boolean   @default(false)
  totpSecretEnc  String?   @db.Text
  /** Последний пинг из ЛК (кабинет / админка / кабинет заведения); для админки — «сейчас в ЛК» по окну lk-presence */
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  establishmentRelation Establishment?  @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  poolForEstablishment  Establishment? @relation("TipPoolUser") // пользователь-пул для чаевых заведения (RECIPIENT, без входа)
  employeeProfile       Employee?      // если роль EMPLOYEE — привязка к сотруднику заведения
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  tipLinks              TipLink[]
  transactions          Transaction[] @relation("RecipientTransactions")
  payoutRequests        PayoutRequest[]
  createdRegistrationTokens RegistrationToken[] @relation("CreatedRegistrationTokens")
  usedRegistrationTokens    RegistrationToken[] @relation("UsedRegistrationTokens")
  paygineCubbies            PaygineCubbie[]
  supportThread             SupportThread?
  supportMessagesAuthored   SupportMessage[] @relation("SupportMessageAuthor")
  verificationRequests     VerificationRequest[]
  fraudSignals             FraudSignal[]
  employeeJoinRequests   EmployeeJoinRequest[]
  employeeLeaveRequests  EmployeeLeaveRequest[]

  @@index([login])
  @@index([email])
  @@index([apiKeyPrefix])
  @@index([establishmentId])
  @@index([lastAuthIp])
  @@index([lastSeenAt])
  @@map("users")
}

model PaygineCubbie {
  id     String  @id @default(cuid())
  sdRef  String  @unique @db.VarChar(128)
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sdRef])
  @@index([userId])
  @@map("paygine_cubbies")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  refreshToken String @unique @db.VarChar(512)
  deviceInfo String?  @db.Text // JSON: {ip, userAgent, deviceClientId?, totp?}
  /** Последняя активность по refresh (продление токена) */
  lastSeenAt DateTime @default(now())
  geoCountry String?  @db.VarChar(128)
  geoCity    String?  @db.VarChar(128)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model TipLink {
  id         String   @id @default(cuid())
  userId     String
  slug       String   @unique @db.VarChar(50) // код официанта в пути /pay/{slug} (уникален глобально)
  employeeId String?  @db.VarChar(64) // если ссылка привязана к сотруднику заведения (чаевые в пул)
  createdAt  DateTime @default(now())

  // Relations
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([slug])
  @@index([employeeId])
  @@map("tip_links")
}

/// Глобальный порядковый счётчик кодов официанта (одна строка id = global).
model WaiterCodeSequence {
  id            String @id @db.VarChar(32)
  lastAllocated Int    @default(0)

  @@map("waiter_code_sequence")
}

model Transaction {
  id              String            @id @default(cuid())
  linkId           String
  recipientId     String            // денормализация для быстрого доступа
  amountKop       BigInt            // сумма в копейках (BigInt для точности)
  feeKop          BigInt?           // комиссия при приёме СБП; при переливе СБП — на кубышку ЮЛ
  paymentMethod   String?           @db.VarChar(16) // 'sbp' | 'card'; только для СБП делается split (fee→ЮЛ, остаток→официант)
  payerInfo       String?           @db.Text // JSON: {phone?, email?, name?} — опционально
  status          TransactionStatus @default(PENDING)
  externalId      String?           @unique @db.VarChar(255) // ID от платёжного провайдера
  paygineOrderSdRef String?         @db.VarChar(128) // кубышка заказа (временная, после оплаты — Relocate на кубышку официанта)
  idempotencyKey  String            @unique @db.VarChar(255) // для идемпотентности
  initiatorIp     String?           @db.VarChar(64) // IP клиента при создании заказа (наблюдение скорости успешных оплат)
  relocateStartedAt DateTime?       // установить при старте перелива — защита от двойного запуска (два вебхука)
  /// При персональном QR и доле заведения: сумма (коп.), ушедшая на счёт пула заведения после оплаты
  establishmentShareKop BigInt?
  /// userId пула заведения для учёта establishmentShareKop в балансе пула
  poolShareRecipientId String?      @db.VarChar(64)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  link     TipLink @relation(fields: [linkId], references: [id], onDelete: Restrict)
  recipient User   @relation("RecipientTransactions", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([linkId])
  @@index([recipientId])
  @@index([poolShareRecipientId])
  @@index([status])
  @@index([externalId])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@index([initiatorIp, status, updatedAt])
  @@index([recipientId, status, createdAt])
  @@map("transactions")
}

model PayoutRequest {
  id                String       @id @default(cuid())
  userId            String
  amountKop         BigInt       // сумма в копейках
  details           String       @db.Text // текст: "Карта: ..." или "Телефон (банк): ..."
  recipientName     String?      @db.VarChar(255) // ФИО получателя при переводе по телефону
  status            PayoutStatus @default(CREATED)
  externalId        String?      @unique @db.VarChar(255) // ID от платёжного провайдера
  completedByUserId String?      @db.VarChar(64) // ID пользователя, выполнившего выплату (для чека)
  feeKop            BigInt?      // комиссия в копейках (опционально)
  rejectionReason   String?      @db.VarChar(500) // причина отклонения от Paygine (при status = REJECTED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([externalId])
  @@index([createdAt])
  @@map("payout_requests")
}

model RegistrationToken {
  id              String    @id @default(cuid())
  tokenHash       String    @unique @db.VarChar(64)
  createdById     String
  usedById        String?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  usedAt          DateTime?
  establishmentId String?   @db.VarChar(64) // токен для регистрации управляющего этого заведения
  employeeId      String?   @db.VarChar(64) // токен для регистрации официанта (привязка к Employee)

  createdBy          User                @relation("CreatedRegistrationTokens", fields: [createdById], references: [id], onDelete: Restrict)
  usedBy             User?               @relation("UsedRegistrationTokens", fields: [usedById], references: [id], onDelete: SetNull)
  registrationRequest RegistrationRequest?
  establishment      Establishment?     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  employee           Employee?           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([usedById])
  @@index([expiresAt])
  @@index([establishmentId])
  @@index([employeeId])
  @@map("registration_tokens")
}

model RegistrationRequest {
  id                   String                     @id @default(cuid())
  requestType          String                     @default("individual") @db.VarChar(20) // "establishment" | "individual"
  fullName             String                     @db.VarChar(255)
  dateOfBirth          String                     @db.VarChar(20)
  establishment        String                     @db.VarChar(255)
  phone                String                     @db.VarChar(50)
  activityType         String                     @db.VarChar(255)
  email                String                     @db.VarChar(255)
  status               RegistrationRequestStatus @default(PENDING)
  rejectionReason      String?                    @db.VarChar(1000)
  reviewedAt           DateTime?
  reviewedByUserId     String?                    @db.VarChar(64)
  registrationTokenId  String?                    @unique
  createdAt            DateTime                   @default(now())
  // Заведение: данные о компании и контактном лице
  companyName          String?                    @db.VarChar(255)
  companyRole          String?                    @db.VarChar(255)
  employeeCount        Int?
  // Отдельный получатель: контакт администратора для подтверждения
  adminFullName        String?                    @db.VarChar(255)
  adminContactPhone    String?                    @db.VarChar(50)

  registrationToken RegistrationToken? @relation(fields: [registrationTokenId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([requestType])
  @@map("registration_requests")
}

// Заявка на верификацию официанта: ФИО, дата рождения, паспорт, ИНН, документы.
model VerificationRequest {
  id                String   @id @default(cuid())
  userId            String
  fullName          String   @db.VarChar(255)
  birthDate         String   @db.VarChar(20)
  passportSeries    String   @db.VarChar(10)
  passportNumber   String   @db.VarChar(20)
  inn               String   @default("") @db.VarChar(14)
  status            RegistrationRequestStatus @default(PENDING) // PENDING | APPROVED | REJECTED
  rejectionReason   String?  @db.VarChar(1000)
  reviewedAt        DateTime?
  reviewedByUserId  String?  @db.VarChar(64)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents VerificationDocument[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("verification_requests")
}

// Документы верификации: разворот паспорта (главный), селфи; в БД могут быть legacy passport_main.
model VerificationDocument {
  id          String   @id @default(cuid())
  requestId   String
  type        String   @db.VarChar(20) // passport_spread | selfie | passport_main (legacy)
  filePath    String   @db.VarChar(512) // относительный путь в storage/verification
  downloadedAt DateTime? // legacy: раньше помечали выгрузку; cleanup удаляет такие записи старше 24 ч
  createdAt   DateTime @default(now())

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([downloadedAt])
  @@map("verification_documents")
}

// Заведение (кафе, ресторан): управляющий, сотрудники, правила распределения чаевых.
model Establishment {
  id                String   @id @default(cuid())
  name              String   @db.VarChar(255)
  address           String?  @db.Text
  phone             String?  @db.VarChar(50)
  logoUrl           String?  @db.VarChar(512)
  logoOpacityPercent Int?    // прозрачность лого 0–100, null = 100
  uniqueSlug        String   @unique @db.VarChar(50) // код заведения в /pay/{uniqueSlug} для пула; новые — из глобальной последовательности NNN-NNN
  maxEmployeesCount Int?     // лимит сотрудников (null = без лимита); задаёт суперадмин
  tipPoolUserId     String?  @unique @db.VarChar(64) // пользователь-пул для приёма чаевых по QR сотрудников
  primaryColor      String?  @db.VarChar(20) // hex для White Label (например #c9a227)
  secondaryColor    String?  @db.VarChar(20) // доп. цвет: фон, акценты
  mainBackgroundColor   String?  @db.VarChar(20) // фон основной страницы (hex)
  mainBackgroundOpacityPercent Int?  // прозрачность фона основной страницы 0–100, null = 100
  blocksBackgroundColor String?  @db.VarChar(20) // фон блоков/карточек (hex)
  blocksBackgroundOpacityPercent Int?  // прозрачность фона блоков 0–100, null = 100
  secondaryOpacityPercent Int?  // прозрачность доп. цвета (фон карточки, сайдбар) 0–100, null = 100
  fontColor         String?  @db.VarChar(20) // цвет основного текста (hex)
  borderColor       String?  @db.VarChar(20) // цвет обводки/рамок (hex)
  borderWidthPx     Int?     // толщина обводки (px), null = 2
  borderOpacityPercent Int?  // прозрачность обводки 0–100, null = 100
  printCardWidthMm  Int?     // ширина карточки для печати (мм), null = 67
  printCardHeightMm Int?     // высота карточки для печати (мм), null = 49
  printCardFooterColor String? @db.VarChar(20) // цвет подписи «Отсканируйте для чаевых» (hex), null = fontColor
  /// Шаблон печати: classic — тёмная карточка; white_pos — белая «как у терминала» (логотипы, QR в рамке, подпись внизу)
  printCardTemplate    String?  @db.VarChar(32)
  /// Логотип партнёра/сервиса слева вверху (URL), только для white_pos
  printPartnerLogoUrl  String?  @db.VarChar(512)
  /// Текст под QR внутри серой рамки (по умолчанию «Отсканируйте QR-код»)
  printQrHintText      String?  @db.VarChar(160)
  /// Текст в «капсуле» над подписью внизу; пусто = название заведения
  printBannerText      String?  @db.VarChar(100)
  /// Подзаголовок под линией (например «команда ресторана»)
  printBannerSubtext   String?  @db.VarChar(160)
  /// Режим QR: POOL_QR — общий счёт заведения; EMPLOYEE_QR — на ЛК официанта с опциональным срезом %
  tipRoutingMode    String?  @db.VarChar(20)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users              User[]              // ESTABLISHMENT_ADMIN привязаны сюда
  tipPoolUser        User?               @relation("TipPoolUser", fields: [tipPoolUserId], references: [id], onDelete: SetNull)
  employees          Employee[]
  payoutRules        PayoutRule[]
  registrationTokens RegistrationToken[] // токены для регистрации управляющего
  employeeJoinRequests EmployeeJoinRequest[]
  employeeLeaveRequests EmployeeLeaveRequest[]
  halls                EstablishmentHall[]
  bookings             EstablishmentBooking[]
  guests               EstablishmentGuest[]
  menuCategories       EstablishmentMenuCategory[]
  serviceSessions      EstablishmentServiceSession[]
  tableOrders          EstablishmentTableOrder[]

  @@index([uniqueSlug])
  @@map("establishments")
}

/// Зал заведения (для карты зала, брони и привязки столов к официантам — дальше по плану).
model EstablishmentHall {
  id              String   @id @default(cuid())
  establishmentId String
  name            String   @db.VarChar(120)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  tables        EstablishmentTable[]

  @@index([establishmentId])
  @@map("establishment_halls")
}

/// Стол в зале; externalCode — задел под интеграцию с кассой.
model EstablishmentTable {
  id           String   @id @default(cuid())
  hallId       String
  label        String   @db.VarChar(80)
  capacity     Int      @default(2)
  sortOrder    Int      @default(0)
  externalCode String?  @db.VarChar(64)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hall             EstablishmentHall              @relation(fields: [hallId], references: [id], onDelete: Cascade)
  bookings         EstablishmentBooking[]
  serviceSessions  EstablishmentServiceSession[]

  @@unique([hallId, label])
  @@index([hallId])
  @@map("establishment_tables")
}

/// Бронь столика в заведении (время хранится как момент в UTC; в UI — календарный день Москвы).
model EstablishmentBooking {
  id              String                     @id @default(cuid())
  establishmentId String
  tableId         String?
  guestId         String?
  guestName       String                     @db.VarChar(120)
  guestPhone      String?                    @db.VarChar(40)
  guestEmail      String?                    @db.VarChar(255)
  partySize       Int                        @default(1)
  startsAt        DateTime
  endsAt          DateTime
  status          EstablishmentBookingStatus @default(PENDING)
  notes           String?                    @db.VarChar(500)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  establishment Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  table         EstablishmentTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guest         EstablishmentGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([establishmentId, startsAt])
  @@index([tableId, startsAt])
  @@index([guestId])
  @@map("establishment_bookings")
}

/// Гость заведения (карточка для броней и истории визитов).
model EstablishmentGuest {
  id              String   @id @default(cuid())
  establishmentId String
  displayName     String   @db.VarChar(120)
  phone           String?  @db.VarChar(40)
  email           String?  @db.VarChar(255)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  bookings      EstablishmentBooking[]
  tableOrders   EstablishmentTableOrder[]

  @@index([establishmentId])
  @@map("establishment_guests")
}

/// Категория меню заведения.
model EstablishmentMenuCategory {
  id              String   @id @default(cuid())
  establishmentId String
  name            String   @db.VarChar(120)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  items         EstablishmentMenuItem[]

  @@index([establishmentId])
  @@map("establishment_menu_categories")
}

/// Позиция меню (цена в копейках).
model EstablishmentMenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String   @db.VarChar(160)
  description String?  @db.VarChar(500)
  priceKop    BigInt   @default(0)
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   EstablishmentMenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderLines EstablishmentTableOrderLine[]

  @@index([categoryId])
  @@map("establishment_menu_items")
}

/// Открытая/закрытая смена обслуживания стола (официант, без позиций чека — оплата отдельно).
model EstablishmentServiceSession {
  id              String                           @id @default(cuid())
  establishmentId String
  tableId         String
  employeeId      String?
  status          EstablishmentServiceSessionStatus @default(OPEN)
  openedAt        DateTime                         @default(now())
  closedAt        DateTime?

  establishment Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  table         EstablishmentTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  employee      Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  tableOrder    EstablishmentTableOrder?

  @@index([establishmentId, status])
  @@index([tableId, status])
  @@index([employeeId])
  @@map("establishment_service_sessions")
}

/// Один заказ на открытую сессию стола (MVP).
model EstablishmentTableOrder {
  id               String                        @id @default(cuid())
  establishmentId  String
  serviceSessionId String                        @unique
  employeeId       String
  status           EstablishmentTableOrderStatus @default(OPEN)
  totalKop         BigInt                        @default(0)
  guestId          String?
  presentedAt      DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  establishment  Establishment               @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  serviceSession   EstablishmentServiceSession @relation(fields: [serviceSessionId], references: [id], onDelete: Cascade)
  employee         Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  guest            EstablishmentGuest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  lines            EstablishmentTableOrderLine[]

  @@index([establishmentId])
  @@index([employeeId])
  @@map("establishment_table_orders")
}

model EstablishmentTableOrderLine {
  id               String   @id @default(cuid())
  orderId          String
  menuItemId       String?
  nameSnapshot     String   @db.VarChar(160)
  priceKopSnapshot BigInt
  quantity         Int      @default(1)
  comment          String?  @db.VarChar(200)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order    EstablishmentTableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem EstablishmentMenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("establishment_table_order_lines")
}

/// Заявка официанта (RECIPIENT) на подключение к заведению по коду точки.
model EmployeeJoinRequest {
  id                String                    @id @default(cuid())
  establishmentId   String
  userId            String
  status            RegistrationRequestStatus @default(PENDING)
  rejectionReason   String?                   @db.VarChar(1000)
  reviewedAt        DateTime?
  reviewedByUserId  String?                   @db.VarChar(64)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([establishmentId, status])
  @@index([userId, status])
  @@map("employee_join_requests")
}

/// Заявка официанта (EMPLOYEE) на выход из заведения — исполняется после одобрения администратора.
model EmployeeLeaveRequest {
  id                String                    @id @default(cuid())
  establishmentId   String
  userId            String
  status            RegistrationRequestStatus @default(PENDING)
  rejectionReason   String?                   @db.VarChar(1000)
  reviewedAt        DateTime?
  reviewedByUserId  String?                   @db.VarChar(64)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([establishmentId, status])
  @@index([userId, status])
  @@map("employee_leave_requests")
}

// Сотрудник заведения (официант): может быть без привязки к User до регистрации/инвайта.
model Employee {
  id               String   @id @default(cuid())
  establishmentId  String
  name             String   @db.VarChar(255)
  position         String?  @db.VarChar(100)
  coefficient      Decimal  @default(1) @db.Decimal(10, 2) // для распределения по коэффициентам
  isActive         Boolean  @default(true)
  qrCodeIdentifier String   @unique @db.VarChar(50) // код официанта (= TipLink.slug) для /pay и QR
  userId           String?  @unique @db.VarChar(64) // привязка к User после регистрации/инвайта
  photoUrl         String?  @db.VarChar(512) // путь к фото: страница оплаты и ЛК (рекомендуется ≥200×200 px)
  printCardPhotoUrl String? @db.VarChar(512) // путь к фото для печатной карточки QR (отдельное, рекомендуется ≥150×150 px)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  establishment      Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  tipLinks           TipLink[]           // приём чаевых (TipLink.slug = qrCodeIdentifier), ведут в пул заведения
  registrationTokens RegistrationToken[] // токены для регистрации официанта (1 токен = 1 сотрудник)
  reviews            EmployeeReview[]
  serviceSessions    EstablishmentServiceSession[]
  tableOrders        EstablishmentTableOrder[]

  @@index([establishmentId])
  @@index([qrCodeIdentifier])
  @@map("employees")
}

// Отзыв/рейтинг по сотруднику (после оплаты или отдельно).
model EmployeeReview {
  id         String   @id @default(cuid())
  employeeId String
  rating     Int      // 1–5
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_reviews")
}

// Правило распределения чаевых по заведению (равномерно, по коэффициентам, процент в фонд и т.д.).
model PayoutRule {
  id             String   @id @default(cuid())
  establishmentId String
  name           String   @db.VarChar(100)
  type           String   @db.VarChar(20) // percentage | fixed | charity
  value          Decimal  @db.Decimal(10, 4) // процент или фикс в копейках
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("payout_rules")
}

// Чат поддержки: один тред на пользователя (клиента), сообщения от клиента и от сотрудников (ADMIN/SUPERADMIN).
model SupportThread {
  id          String    @id @default(cuid())
  userId      String    @unique // один тред на пользователя
  lastReadAt  DateTime? // когда клиент последний раз открывал чат (для счётчика непрочитанных)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([updatedAt])
  @@map("support_threads")
}

model SupportMessage {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String   // кто написал (User: клиент или сотрудник)
  body      String   @db.Text
  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User          @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([createdAt])
  @@map("support_messages")
}

// Дефолтные лимиты для новых пользователей (задаются в блоке антифрода админки).
// Одна запись (id = "default"); при "Применить" в антифроде — обновляется; при регистрации — читается.
model SystemDefaultLimits {
  id                            String   @id @default("default")
  payoutDailyLimitCount         Int?
  payoutDailyLimitKop           BigInt?
  payoutMonthlyLimitCount      Int?
  payoutMonthlyLimitKop        BigInt?
  incomingMonthlyLimitKop      BigInt?
  autoConfirmPayouts           Boolean  @default(false)
  autoConfirmPayoutThresholdKop BigInt?
  /** Пороги наблюдения (сигналы без блокировок); null = встроенные дефолты в коде */
  observePayoutWindowMinutes         Int?
  observePayoutMinCount              Int?
  observePayInitWindowMinutes        Int?
  observePayInitMinCount             Int?
  observePaySuccessIpWindowMinutes   Int?
  observePaySuccessIpMinCount        Int?
  observeSharedIpMinAccounts         Int?
  updatedAt                     DateTime @updatedAt

  @@map("system_default_limits")
}

// Глобальный стоп-приём и белый/чёрный списки аккаунтов (user id) для ссылок /pay.
// id = "main" — единственная строка.
model PlatformPaymentSettings {
  id                      String   @id @default("main")
  globalPaymentsDisabled  Boolean  @default(false)
  paymentWhitelistUserIds String[] @default([])
  paymentBlacklistUserIds String[] @default([])
  /// Макс. сумма входящих за сутки МСК (коп.): SUCCESS за сегодня + только PENDING с createdAt не старше окна «свежести» (интервал ниже или 5 мин) + новый платёж. null — без лимита.
  recipientMaxIncomingKopPerMskDay BigInt?
  /// Макс. одновременных PENDING с тем же окном свежести (старые неоплаченные не занимают слот). null — без лимита.
  recipientMaxConcurrentPendingPayments Int?
  /// Интервал между созданием заказов (мин.); также длительность окна, в течение которого PENDING учитывается в суточной сумме и в лимите одновременных. null — для окна свежести используется 5 мин.
  recipientMinMinutesBetweenPayInits Int?
  /// Макс. число успешных зачислений на получателя за календарные сутки МСК (по времени зачисления). null — без лимита.
  recipientMaxPayInitsPerDay Int?
  updatedAt               DateTime @updatedAt

  @@map("platform_payment_settings")
}

// Сигналы для наблюдения в админке (антифрод): не блокируют платежи автоматически.
model FraudSignal {
  id        String   @id @default(cuid())
  userId    String
  ruleCode  String   @db.VarChar(64)
  message   String   @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([ruleCode])
  @@map("fraud_signals")
}
