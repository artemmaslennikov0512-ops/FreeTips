<?xml version="1.0" encoding="utf-8"?>
<!-- Карта в актуальном стиле: глубокий бирюзовый градиент -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#166E68"
                android:centerColor="#1A8F87"
                android:endColor="#0B4E49"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
